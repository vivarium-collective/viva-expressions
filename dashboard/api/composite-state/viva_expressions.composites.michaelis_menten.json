{"id": "viva_expressions.composites.michaelis_menten", "name": "michaelis_menten", "description": "Michaelis-Menten substrate depletion dS/dt = -Vmax*S/(Km+S), dP/dt = +Vmax*S/(Km+S) integrated by OdeProcess; oracles are the closed form S(t) = Km*W((S0/Km)*exp((S0 - Vmax*t)/Km)) (Lambert W) and the conserved total S+P = S0.", "parameters": {"Vmax": {"type": "float", "default": 1.0, "description": "Maximal reaction rate (concentration/time)."}, "Km": {"type": "float", "default": 2.0, "description": "Michaelis constant (concentration). Small Km/S0 makes the system stiff as S -> 0."}, "S0": {"type": "float", "default": 10.0, "description": "Initial substrate concentration."}, "method": {"type": "string", "default": "LSODA", "description": "scipy solve_ivp method (LSODA, RK45, DOP853, Radau, BDF)."}, "rtol": {"type": "float", "default": 1e-08, "description": "Solver relative tolerance."}, "atol": {"type": "float", "default": 1e-10, "description": "Solver absolute tolerance."}}, "state": {"enzyme": {"_type": "process", "address": "local:OdeProcess", "config": {"rhs": {"S": "-Vmax*S/(Km + S)", "P": "Vmax*S/(Km + S)"}, "params": {"Vmax": 1.0, "Km": 2.0}, "state_vars": ["S", "P"], "input_vars": [], "method": "LSODA", "rtol": 1e-08, "atol": 1e-10}, "interval": 0.5, "inputs": {"S": ["stores", "S"], "P": ["stores", "P"]}, "outputs": {"S": ["stores", "S"], "P": ["stores", "P"]}}, "stores": {"S": 10.0, "P": 0.0}, "emitter": {"_type": "step", "address": "local:JSONEmitter", "config": {"emit": {"S": "float", "P": "float", "time": "float"}}, "inputs": {"S": ["stores", "S"], "P": ["stores", "P"], "time": ["global_time"]}}, "_declared_emit_paths": ["stores/S", "stores/P", "global_time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["OdeProcess"]}, "tags": ["ode", "expressions", "validation"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}