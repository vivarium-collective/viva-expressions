{"id": "viva_expressions.composites.logistic_growth", "name": "logistic_growth", "description": "Logistic growth dN/dt = r*N*(1-N/K) integrated by OdeProcess; closed-form solution N(t)=K/(1+((K-N0)/N0)*exp(-r t)) is the validation oracle.", "parameters": {"r": {"type": "float", "default": 0.5, "description": "Intrinsic growth rate (1/time)."}, "K": {"type": "float", "default": 100.0, "description": "Carrying capacity."}, "N0": {"type": "float", "default": 5.0, "description": "Initial population."}, "method": {"type": "string", "default": "LSODA", "description": "scipy solve_ivp method (LSODA, RK45, DOP853, Radau, BDF)."}, "rtol": {"type": "float", "default": 1e-08, "description": "Solver relative tolerance."}, "atol": {"type": "float", "default": 1e-10, "description": "Solver absolute tolerance."}}, "state": {"growth": {"_type": "process", "address": "local:OdeProcess", "config": {"rhs": {"N": "r*N*(1 - N/K)"}, "params": {"r": 0.5, "K": 100.0}, "state_vars": ["N"], "input_vars": [], "method": "LSODA", "rtol": 1e-08, "atol": 1e-10}, "interval": 0.5, "inputs": {"N": ["stores", "N"]}, "outputs": {"N": ["stores", "N"]}}, "stores": {"N": 5.0}, "emitter": {"_type": "step", "address": "local:JSONEmitter", "config": {"emit": {"N": "float", "time": "float"}}, "inputs": {"N": ["stores", "N"], "time": ["global_time"]}}, "_declared_emit_paths": ["stores/N", "global_time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["OdeProcess"]}, "tags": ["ode", "expressions", "validation"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}